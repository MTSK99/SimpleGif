<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- DayNight：跟随系统白天/深色模式自动切换 values 与 values-night -->
    <style name="Theme.SimpleGif" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorOnSecondary">@color/on_brand</item>
        <item name="colorSecondaryContainer">@color/chip_selected</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>

        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/surface_high</item>

        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>

        <item name="materialAlertDialogTheme">@style/ThemeOverlay.SimpleGif.Dialog</item>
    </style>

    <style name="ThemeOverlay.SimpleGif.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>

</resources>
