# 代理：一般不用填。
# 启动时会自动读取 Windows 系统代理 / macOS 网络偏好里的代理设置。
# 只有系统里没配、但你想单独指定时，才在这里写（会自动转成大/小写各一份，ffmpeg 也认）。
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897

# 解析服务：默认 api.fxtwitter.com；要换接口时写自己的（多个用逗号分隔）
# RESOLVER_API=https://api.fxtwitter.com

# 解析接口超时（秒）
# RESOLVE_TIMEOUT=12

# 服务端口与监听地址
# PORT=8000
# HOST=0.0.0.0

# 允许下载的源文件上限（MB）
# MAX_DOWNLOAD_MB=60

# 允许额外下载的媒体域名（逗号分隔），默认只允许 *.twimg.com
# ALLOW_EXTRA_HOSTS=

# 成品文件保留时长（小时）与最多保留任务数
# JOB_TTL_HOURS=6
# MAX_JOBS=200

# 同时转码的任务数
# MAX_WORKERS=2

# 保留下载的源文件（排查问题时用）
# KEEP_SOURCE=0

# 排查解析失败时设为 1，错误信息会带上每一层的失败原因
# DEBUG_RESOLVE=1

# ffmpeg 不在 PATH 里时手动指定
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
